# =============================================================================
# Sellora AI — environment configuration
# Copy to `.env` in the project root and fill in real values.
# NEVER commit `.env`. Values below are placeholders, not working secrets.
# See docs/ENVIRONMENT.md for a full description of every variable.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_NAME="Sellora AI"
# Public URL of the web app (no trailing slash)
APP_URL=http://localhost:3000
# Public URL of the API as seen by browsers (no trailing slash).
# Behind Nginx this is usually the same host as APP_URL.
API_URL=http://localhost:4000
# URL the Next.js server uses to reach the API during development (rewrites).
API_INTERNAL_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
# Comma separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000
# Set to true when the app is served over HTTPS (secure cookies)
COOKIE_SECURE=false
# Optional cookie domain, e.g. .example.com (leave empty for host-only cookies)
COOKIE_DOMAIN=
# Trust X-Forwarded-* headers from the reverse proxy (true behind Nginx)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database (PostgreSQL 14+) -----------------------------------------------
DATABASE_URL=postgresql://sellora:change_me@localhost:5432/sellora?schema=public

# --- Redis (6.2+ recommended) -------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Security -------------------------------------------------------------------
# Generate each with: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# 32-byte key (64 hex chars) used to encrypt stored secrets (WhatsApp tokens, AI keys, 2FA)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Optional token required by the web installation wizard
INSTALLER_TOKEN=

# --- AI (OpenAI or any OpenAI-compatible API) -------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# USD price per 1M tokens, used for estimated AI cost reporting
AI_PRICE_INPUT_PER_1M=0.15
AI_PRICE_OUTPUT_PER_1M=0.60

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# Accounts are normally connected per workspace in Settings → WhatsApp.
# These values act as platform defaults / single-tenant fallback.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- Facebook Messenger & Instagram (optional) ---------------------------------
# Businesses connect their own Page in Integrations. These are only fallbacks
# when every workspace uses the same Meta app.
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Outgoing webhooks ----------------------------------------------------------
# Only for local testing: allow webhook URLs on private/LAN addresses.
WEBHOOKS_ALLOW_PRIVATE=false

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Sellora AI <no-reply@example.com>"

# --- File storage ---------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=10

# --- Billing ------------------------------------------------------------------
# Leave empty to run without an online payment provider (manual plans).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Backups (used by deploy/scripts/backup-db.sh) ---------------------------
BACKUP_DIR=/opt/sellora-ai/backups
BACKUP_RETENTION_DAYS=14
