{
  "name": "@sellora/api",
  "version": "1.0.0",
  "private": true,
  "description": "Sellora AI REST API, realtime gateway and background worker",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --entryFile worker",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit",
    "test:cov": "jest --config jest.config.js --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "db:seed": "dotenv -e ../../.env -- ts-node --transpile-only prisma/seed.ts",
    "db:seed:demo": "dotenv -e ../../.env -- ts-node --transpile-only prisma/seed.ts --demo",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "11.2.6",
    "@prisma/client": "6.19.3",
    "@sellora/shared": "1.0.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "argon2": "^0.44.0",
    "bullmq": "5.81.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "file-type": "^16.5.4",
    "helmet": "^8.1.0",
    "ioredis": "5.11.1",
    "mammoth": "^1.11.0",
    "nestjs-pino": "4.6.1",
    "nodemailer": "^7.0.9",
    "openai": "^5.23.0",
    "otplib": "12.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pino": "^9.13.0",
    "pino-http": "10.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "11.2.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "eslint": "9.39.5",
    "globals": "^16.4.0",
    "jest": "29.7.0",
    "pino-pretty": "^13.1.2",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "dotenv-cli": "^10.0.0"
  }
}
